{
    "version": 2,
    "builds": [
        {
            "src": "api/index.ts",
            "use": "@vercel/node",
            "config": {
                "includeFiles": [
                    "src/**/*",
                    "prisma/**/*",
                    "node_modules/better-auth/**/*"
                ],
                "external": [
                    "better-auth",
                    "better-auth/node",
                    "better-auth/adapters/prisma",
                    "better-auth/client/plugins",
                    "better-auth/react"
                ]
            }
        }
    ],
    "routes": [
        {
            "src": "/(.*)",
            "dest": "/api/index.ts"
        }
    ]
}